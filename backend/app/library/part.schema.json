            0
          ],
          "normal": "-Y",
          "up": "+Z",
          "side": "front",
          "wall": "t",
          "door": {
            "when": "True",
            "width": "door_width_mm",
            "profile": "door_shape"
          },
          "fields": {
            "width": "width_mm",
            "height": "height_mm",
            "wall": "wall_thickness_mm",
            "port": "door_width_mm",
            "profile": "door_shape"
          }
        },
        "back": {
          "origin": [
            0,
            "D / 2",
            0
          ],
          "normal": "+Y",
          "up": "+Z",
          "side": "back",
          "wall": "t",
          "door": {
            "when": "door_count >= 2",
            "width": "door_width_mm",
            "profile": "door_shape"
          },
          "mount": [
            "-W / 2",
            "W / 2",
            "H"
          ],
          "fields": {
            "width": "width_mm",
            "height": "height_mm",
            "wall": "wall_thickness_mm",
            "port": "door_width_mm",
            "profile": "door_shape"
          }
        },
        "left": {
          "origin": [
            "-W / 2",
            0,
            0
          ],
          "normal": "-X",
          "up": "+Z",
          "mount": [
            "-D / 2",
            "D / 2",
            "H"
          ],
          "fields": {
            "width": "depth_mm",
            "height": "height_mm"
          }
        },
        "right": {
          "origin": [
            "W / 2",
            0,
            0
          ],
          "normal": "+X",
          "up": "+Z",
          "mount": [
            "-D / 2",
            "D / 2",
            "H"
          ],
          "fields": {
            "width": "depth_mm",
            "height": "height_mm"
          }
        },
        "top": {
          "origin": [
            0,
            0,
            "H"
          ],
          "normal": "+Z",
          "up": "+Y"
        }
      },
      "envelope": [
        "W",
        "D",
        "H"
      ],
      "features": {}
    }
