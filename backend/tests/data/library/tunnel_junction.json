{
  "dsl": 1,
  "family": "tunnel_junction",
  "name": {
    "ko": "터널 갈림길",
    "en": "Tunnel junction"
  },
  "description": {
    "ko": "터널 여러 개가 만나는 작은 방. 출입구 배치 I(앞·뒤), L(앞·왼쪽), T(앞·왼쪽·오른쪽), X(네 면). 출입구마다 터널을 잇고, 출입구 단면은 이은 터널에 맞춘다.",
    "en": "A small chamber where tunnels meet. Door layout I (front, back), L (front, left), T (front, left, right) or X (all four). Each door takes a tunnel; the door shape follows the tunnel."
  },
  "keywords": {
    "ko": [
      "갈림길",
      "분기",
      "T자",
      "십자",
      "터널 연결"
    ],
    "en": [
      "junction",
      "hub",
      "t-piece",
      "cross",
      "splitter"
    ]
  },
  "fulfills": [
    "터널갈림길",
    "터널분기",
    "터널연결부"
  ],
  "part_id": "hub",
  "color": "#c9a46e",
  "habitats": [
    "cage"
  ],
  "role": "room_host",
  "attach_order": {
    "passage": [
      "front",
      "back",
      "left",
      "right"
    ]
  },
  "height_field": "height_mm",
  "size_fields": [
    "size_mm"
  ],
  "door_fields": [
    "layout",
    "door_shape"
  ],
  "params": {
    "wall_thickness_mm": {
      "type": "number",
      "default": 3,
      "min": 2.3,
      "max": 6,
      "rule_default": "ctx.default_wall_mm",
      "desc": {
        "ko": "벽·지붕 두께 mm",
        "en": "Wall and roof thickness mm"
      }
    },
    "layout": {
      "type": "choice",
      "choices": [
        "I",
        "L",
        "T",
        "X"
      ],
      "default": "T",
      "desc": {
        "ko": "출입구 배치. I=앞·뒤, L=앞·왼쪽, T=앞·왼쪽·오른쪽, X=네 면",
        "en": "Door layout. I=front+back, L=front+left, T=front+left+right, X=all four"
      },
      "choice_labels": {
        "I": {
          "ko": "일자",
          "en": "Straight"
        },
        "L": {
          "ko": "기역자",
          "en": "Corner"
        },
        "T": {
          "ko": "T자",
          "en": "T-piece"
        },
        "X": {
          "ko": "십자",
          "en": "Cross"
        }
      }
    },
    "door_width_mm": {
      "type": "number",
      "default": 60,
      "min": 25,
      "max": 100,
      "rule_default": "ceil(rule.entrance_min_diameter_mm + 5)",
      "desc": {
        "ko": "출입구 폭 mm. 종별 최소 출입구 폭 이상이며 이은 터널 안지름과 같아진다",
        "en": "Door width mm. At least the species minimum; joined tunnels take the same inner width"
      }
    },
    "door_shape": {
      "type": "choice",
      "choices": [
        "round_arch",
        "pointed_arch",
        "box",
        "house"
      ],
      "default": "round_arch",
      "desc": {
        "ko": "출입구 단면 모양",
        "en": "Door shape"
      },
      "choice_labels": {
        "round_arch": {
          "ko": "둥근 아치",
          "en": "Round arch"
        },
        "pointed_arch": {
          "ko": "뾰족 아치",
          "en": "Pointed arch"
        },
        "box": {
          "ko": "네모",
          "en": "Box"
        },
        "house": {
          "ko": "집 모양",
          "en": "House"
        }
      }
    },
    "size_mm": {
      "type": "number",
      "default": 90,
      "min": 60,
      "max": 200,
      "rule_default": "door_width_mm + 2 * wall_thickness_mm + 20",
      "desc": {
        "ko": "외형 가로·세로(정사각형) mm",
        "en": "Outer width and depth (square) mm"
      }
    },
    "height_mm": {
      "type": "number",
      "default": 80,
      "min": 40,
      "max": 200,
      "rule_default": "port_height(door_shape, door_width_mm) + 2 * wall_thickness_mm + 8",
      "desc": {
        "ko": "외형 높이 mm",
        "en": "Outer height mm"
      }
    }
  },
  "let": [
    {
      "name": "S",
      "expr": "size_mm"
    },
    {
      "name": "H",
      "expr": "height_mm"
    },
    {
      "name": "t",
      "expr": "wall_thickness_mm"
    },
    {
      "name": "has_back",
      "expr": "layout in ('I', 'X')"
    },
    {
      "name": "has_left",
      "expr": "layout in ('L', 'T', 'X')"
    },
    {
      "name": "has_right",
      "expr": "layout in ('T', 'X')"
    }
  ],
  "constraints": [
    {
      "field": "door_width_mm",
      "min": "rule.entrance_min_diameter_mm",
      "source": "species",
      "reason": {
        "ko": "{1} 갈림길 출입구는 최소 {0}mm 이상이어야 합니다",
        "en": "{1} junction doors must be at least {0} mm wide"
      }
    },
    {
      "field": "size_mm",
      "min": "door_width_mm + 2 * wall_thickness_mm + 8",
      "source": "geometry",
      "reason": {
        "ko": "모서리에 벽이 남도록 갈림길 가로·세로는 {0}mm 이상이어야 합니다",
        "en": "The junction must be at least {0} mm wide so wall remains at the corners"
      }
    },
    {
      "field": "height_mm",
      "min": "port_height(door_shape, door_width_mm) + 2 * wall_thickness_mm",
      "source": "geometry",
      "reason": {
        "ko": "출입구 위로 벽이 남도록 갈림길 높이는 {0}mm 이상이어야 합니다",
        "en": "The junction must be at least {0} mm tall so wall remains above the doors"
      }
    }
  ],
  "body": [
    {
      "op": "box",
      "size": [
        "S",
        "S",
        "H"
      ]
    },
    {
      "op": "box",
      "mode": "cut",
      "size": [
        "S - 2 * t",
        "S - 2 * t",
        "H - t + 1"
      ],
      "at": [
        0,
        0,
        -1
      ],
      "note": "open bottom, 1 mm below the floor so the cut never shares the bottom face"
    }
  ],
  "print": [
    {
      "key": "body",
      "name": {
        "ko": "본체",
        "en": "Body"
      },
      "rotation": "inverted"
    }
  ],
  "anchors": {
    "front": {
      "origin": [
        0,
        "-S / 2",
        0
      ],
      "normal": "-Y",
      "up": "+Z",
      "side": "front",
      "wall": "t",
      "door": {
        "when": "True",
        "width": "door_width_mm",
        "profile": "door_shape"
      },
      "fields": {
        "width": "size_mm",
        "height": "height_mm",
        "wall": "wall_thickness_mm",
        "port": "door_width_mm",
        "profile": "door_shape"
      }
    },
    "back": {
      "origin": [
        0,
        "S / 2",
        0
      ],
      "normal": "+Y",
      "up": "+Z",
      "side": "back",
      "wall": "t",
      "door": {
        "when": "has_back",
        "width": "door_width_mm",
        "profile": "door_shape"
      },
      "mount": [
        "-S / 2",
        "S / 2",
        "H"
      ],
      "fields": {
        "width": "size_mm",
        "height": "height_mm",
        "wall": "wall_thickness_mm",
        "port": "door_width_mm",
        "profile": "door_shape"
      }
    },
    "left": {
      "origin": [
        "-S / 2",
        0,
        0
      ],
      "normal": "-X",
      "up": "+Z",
      "side": "left",
      "wall": "t",
      "door": {
        "when": "has_left",
        "width": "door_width_mm",
        "profile": "door_shape"
      },
      "mount": [
        "-S / 2",
        "S / 2",
        "H"
      ],
      "fields": {
        "width": "size_mm",
        "height": "height_mm",
        "wall": "wall_thickness_mm",
        "port": "door_width_mm",
        "profile": "door_shape"
      }
    },
    "right": {
      "origin": [
        "S / 2",
        0,
        0
      ],
      "normal": "+X",
      "up": "+Z",
      "side": "right",
      "wall": "t",
      "door": {
        "when": "has_right",
        "width": "door_width_mm",
        "profile": "door_shape"
      },
      "mount": [
        "-S / 2",
        "S / 2",
        "H"
      ],
      "fields": {
        "width": "size_mm",
        "height": "height_mm",
        "wall": "wall_thickness_mm",
        "port": "door_width_mm",
        "profile": "door_shape"
      }
    },
    "top": {
      "origin": [
        0,
        0,
        "H"
      ],
      "normal": "+Z",
      "up": "+Y"
    }
  },
  "envelope": [
    "S",
    "S",
    "H"
  ],
  "features": {}
}
