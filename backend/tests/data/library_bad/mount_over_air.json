{
  "_expect": "C03",
  "_note": "the front mount spans the open passage",
  "dsl": 1,
  "family": "mount_over_air",
  "name": {
    "ko": "시험 부품 12",
    "en": "Test part 12"
  },
  "description": {
    "ko": "양옆 벽 위에 판을 얹은 받침대. 아래는 앞뒤로 트여 있고 옆면에 다른 부품을 끼울 수 있다.",
    "en": "A deck on two side walls, open front to back underneath. Other parts slide onto its sides."
  },
  "keywords": {
    "ko": [
      "받침대"
    ],
    "en": [
      "stand"
    ]
  },
  "fulfills": [],
  "part_id": "mount_over_air",
  "habitats": [
    "cage"
  ],
  "role": "host",
  "attach_order": {},
  "height_field": "height_mm",
  "size_fields": [
    "width_mm",
    "depth_mm"
  ],
  "params": {
    "wall_thickness_mm": {
      "type": "number",
      "default": 3,
      "min": 1.2,
      "max": 8,
      "rule_default": "ctx.default_wall_mm",
      "desc": {
        "ko": "벽 두께 mm",
        "en": "wall thickness mm"
      }
    },
    "width_mm": {
      "type": "number",
      "default": 160,
      "min": 60,
      "max": 210,
      "rule_default": "max(160, max(rule.entrance_min_diameter_mm, rule.gap_trap.passable_min_mm) + 2 * wall_thickness_mm + 60)",
      "desc": {
        "ko": "외형 가로(X) mm",
        "en": "outer width (X) mm"
      }
    },
    "depth_mm": {
      "type": "number",
      "default": 120,
      "min": 60,
      "max": 210,
      "desc": {
        "ko": "외형 세로(Y) mm",
        "en": "outer depth (Y) mm"
      }
    },
    "height_mm": {
      "type": "number",
      "default": 100,
      "min": 50,
      "max": 200,
      "rule_default": "min(100, rule.max_climb_height_mm)",
      "desc": {
        "ko": "외형 높이(Z) mm",
        "en": "outer height (Z) mm"
      }
    },
    "deck_thickness_mm": {
      "type": "number",
      "default": 4,
      "min": 3,
      "max": 10,
      "rule_default": "max(4, ctx.min_wall_mm)",
      "desc": {
        "ko": "윗판 두께 mm",
        "en": "top plate thickness mm"
      }
    }
  },
  "let": [
    {
      "name": "W",
      "expr": "width_mm"
    },
    {
      "name": "D",
      "expr": "depth_mm"
    },
    {
      "name": "H",
      "expr": "height_mm"
    },
    {
      "name": "t",
      "expr": "wall_thickness_mm"
    },
    {
      "name": "dt",
      "expr": "deck_thickness_mm"
    }
  ],
  "constraints": [
    {
      "field": "deck_thickness_mm",
      "min": "max(3, ctx.min_wall_mm)",
      "source": "species",
      "reason": {
        "ko": "윗판은 {0}mm 이상 두꺼워야 합니다",
        "en": "The top plate must be at least {0} mm thick"
      }
    },
    {
      "field": "height_mm",
      "max": "rule.max_climb_height_mm",
      "source": "species",
      "reason": {
        "ko": "떨어져도 다치지 않도록 {1} 받침대 높이는 {0}mm 이하여야 합니다",
        "en": "Keep the stand at most {0} mm high so a {1} pet is not hurt by a fall"
      }
    },
    {
      "field": "height_mm",
      "min": "max(rule.entrance_min_diameter_mm, rule.gap_trap.passable_min_mm) + deck_thickness_mm",
      "source": "species",
      "reason": {
        "ko": "받침대 아래를 끼지 않고 지나가도록 높이는 {0}mm 이상이어야 합니다",
        "en": "The stand must be at least {0} mm high so the passage underneath cannot trap"
      }
    },
    {
      "field": "width_mm",
      "min": "max(rule.entrance_min_diameter_mm, rule.gap_trap.passable_min_mm) + 2 * wall_thickness_mm",
      "source": "species",
      "reason": {
        "ko": "받침대 아래 통로가 넉넉하도록 가로는 {0}mm 이상이어야 합니다",
        "en": "The width must be at least {0} mm so the passage underneath is wide enough"
      }
    },
    {
      "field": "depth_mm",
      "min": "0.5 * height_mm",
      "source": "geometry",
      "reason": {
        "ko": "넘어지지 않도록 받침대 세로는 {0}mm 이상이어야 합니다",
        "en": "The stand must be at least {0} mm deep so it cannot tip over"
      }
    }
  ],
  "body": [
    {
      "op": "box",
      "size": [
        "W",
        "D",
        "dt"
      ],
      "at": [
        0,
        0,
        "H - dt"
      ]
    },
    {
      "op": "box",
      "size": [
        "t",
        "D",
        "H"
      ],
      "at": [
        "(2 * i - 1) * (W / 2 - t / 2)",
        0,
        0
      ],
      "repeat": {
        "i": 2
      }
    }
  ],
  "print": [
    {
      "key": "body",
      "name": {
        "ko": "본체",
        "en": "Body"
      },
      "rotation": "inverted"
    }
  ],
  "anchors": {
    "top": {
      "origin": [
        0,
        0,
        "H"
      ],
      "normal": "+Z",
      "up": "+Y"
    },
    "front": {
      "origin": [
        "W / 2 - t / 2",
        "-D / 2",
        0
      ],
      "normal": "-Y",
      "up": "+Z",
      "mount": [
        "-(W - t)",
        "t / 2",
        "H"
      ]
    }
  },
  "envelope": [
    "W",
    "D",
    "H"
  ],
  "features": {
    "min_wall": "min(wall_thickness_mm, deck_thickness_mm)",
    "access_sides": [
      {
        "side": "back"
      }
    ],
    "climb_height": "height_mm",
    "openings": [
      {
        "kind": "passage",
        "size": "min(W - 2 * t, H - dt)",
        "rule_key": "entrance_min_diameter_mm",
        "label": {
          "ko": "받침대 아래 통로",
          "en": "Passage under the stand"
        },
        "probe": {
          "shape": "box",
          "axis": "y",
          "at": [
            0,
            0,
            0
          ],
          "length": "D + 2"
        }
      }
    ]
  }
}
