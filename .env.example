# 꼬물공방 환경변수 예시 – 이 파일을 .env 로 복사해 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# ── LLM ───────────────────────────────────────────────
# Anthropic API 키. 비워 두면 LLM_PROVIDER=auto 일 때 개발용 모의 해석기(mock)를 사용합니다.
ANTHROPIC_API_KEY=
# 사용할 Claude 모델 ID (LLM_PROVIDER 가 anthropic 일 때 필수)
# 모델 목록: https://docs.claude.com/en/docs/about-claude/models/overview
ANTHROPIC_MODEL=
# auto | anthropic | mock
LLM_PROVIDER=auto
# LLM 출력이 JSON 스키마를 위반할 때 재시도 횟수
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

# ── 저장소 ────────────────────────────────────────────
# 비워 두면 backend/data/kkomul.db 사용
# DATABASE_URL=sqlite:///./data/kkomul.db
# MESH_CACHE_DIR=./data/meshes

# ── 규칙 파일 ─────────────────────────────────────────
# species.yaml / printing.yaml 이 있는 디렉터리 (기본: backend/rules/)
# RULES_DIR=./rules

# ── API 경로 ──────────────────────────────────────────
# 백엔드 라우트 접두사. 로컬은 비워 두고, Vercel 배포에서는 /api
# API_PREFIX=

# ── 웹 ────────────────────────────────────────────────
# 프론트엔드 출처 (쉼표 구분)
CORS_ORIGINS=http://localhost:3000
